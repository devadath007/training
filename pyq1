n=int(input("enter the total no of monkeys:"))
m=int(input("enter Total number of Bananas:"))
p=int(input("enter Total number of Peanuts:"))
k=int(input("enter  Number of eatable Bananas by Single Monkey:"))
j=int(input("enter  Number of eatable Peanuts by Single Monkey:"))
if k==0 or j==0 :
  print("invalid op")
else :
  n=n-(m//k + p//j)
  if(m%k!=0 or p%j!=0):
    n=n-1
print("Number of  Monkeys left on the tree:",n)
